# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# ── ML Model (auto-downloaded from Google Drive on first prediction) ──────────
ML_MODEL_URL=https://drive.google.com/uc?id=1YO43M94sUYcs8A-S3MEt6wS9x4gJ8S_Y

# ── OCR (Tesseract) ───────────────────────────────────────────────────────────
# Linux (Render): /usr/bin/tesseract  (install via apt in build.sh)
# Windows (local): C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app-name.onrender.com

# ── Email (optional) ──────────────────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@fakeproductdetector.com
