# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (default: SQLite for dev, PostgreSQL for prod) ───────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/fakeproduct_db

# ── ML Model ──────────────────────────────────────────────────────────────────
# Google Drive direct download URL for the trained model
ML_MODEL_URL=https://drive.google.com/uc?id=1YO43M94sUYcs8A-S3MEt6wS9x4gJ8S_Y
# Optional: override local path (default: models/mobilenet_v2_food_production.keras)
# ML_MODEL_PATH=/absolute/path/to/models/mobilenet_v2_food_production.keras

MODEL_URL=https://drive.google.com/file/d/1YO43M94sUYcs8A-S3MEt6wS9x4gJ8S_Y/view

# ── OCR (Tesseract) ───────────────────────────────────────────────────────────
# Windows default:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac:
# TESSERACT_CMD=/usr/bin/tesseract

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Email (optional — console backend used by default) ───────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@fakeproductdetector.com
