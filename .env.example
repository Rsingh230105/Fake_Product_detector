# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-minimum-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# ── Database (PostgreSQL — RDS in production, local container for Docker dev) ─
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# ── ML Model ──────────────────────────────────────────────────────────────────
# Legacy: only used if deploying to Render (gdown-based download).
# Docker setup downloads the model from S3 instead (see AWS_STORAGE_BUCKET_NAME below).
ML_MODEL_URL=https://drive.google.com/uc?id=YOUR_FILE_ID_HERE

# ── Tesseract OCR ─────────────────────────────────────────────────────────────
# Linux / Render / Docker: /usr/bin/tesseract  (installed via apt)
# Windows local:           C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-app.onrender.com

# ── AWS S3 (media storage + ML model download for Docker) ─────────────────────
USE_S3=True
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Local Docker testing only — production (EC2) uses IAM Role, no keys needed
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email (optional — leave blank to use console backend) ─────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@yourapp.com